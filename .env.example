# Copy to .env and fill in. .env must be gitignored.

# ---- Model (AWS Bedrock, Converse API) ----
AWS_REGION=us-east-1
# Bearer token auth (set this OR access key/secret, not both)
AWS_BEARER_TOKEN_BEDROCK=
# Legacy key/secret auth (leave blank if using bearer token)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Verify availability in your region first:
#   aws bedrock list-foundation-models --region $AWS_REGION | grep qwen
BEDROCK_VL_MODEL_ID=qwen.qwen3-vl-235b-a22b
BEDROCK_TEXT_MODEL_ID=qwen.qwen3-next-80b-a3b
BEDROCK_FORCE_TOOL_CHOICE=true

# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_LAST_PLACE_ROLE_ID=

# ---- Google Calendar ----
# Path to the OAuth client file downloaded from Cloud Console
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json
# Per-member tokens: calendar.readonly only (free/busy). Do not add scopes here.
GOOGLE_TOKEN_DIR=./secrets/tokens

# ---- Google Sheets (debt ledger; replaces Splitwise, which now requires Pro) ----
# Same Cloud project as Calendar. Separate token so adding the spreadsheets scope
# does not invalidate the per-member calendar tokens.
GOOGLE_SHEETS_ID=
GOOGLE_LEDGER_TOKEN_PATH=./secrets/ledger_token.json
SHEETS_DEBTS_RANGE=debts!A:G

# ---- UPI (no API needed; agent renders a QR into the Discord embed) ----
UPI_PAYEE_ADDRESS=
UPI_DEFAULT_AMOUNT=500

# ---- Spotify ----
SPOTIFY_CLIENT_ID=8b4cc64d6f6a40cd80e57360771f42ec
SPOTIFY_CLIENT_SECRET=e6de63c5eaec45d29cf9c003a2cef4c4
SPOTIFY_REFRESH_TOKEN=

# ---- Behaviour ----
ENFORCER_TZ=Asia/Kolkata
ENFORCER_DRY_RUN=true
ENFORCER_INTEGRATIONS=fake          # fake | live | mixed
ENFORCER_MAX_TOOL_CALLS=12
ENFORCER_TASK_TIMEOUT_S=90
ENFORCER_ESCALATE_BELOW_CONFIDENCE=0.75
ENFORCER_POLICY_PATH=./docs/POLICY.md
ENFORCER_LEDGER_PATH=./data/ledger.jsonl
ENFORCER_ACTION_LOG_PATH=./data/run_log.jsonl
